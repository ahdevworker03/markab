{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "openai/gpt-5.6-terra",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },

    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--browser", "chromium"],
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "GITHUB_TOKEN=\"$(gh auth token)\" npx -y github-mcp-server-js"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERMISSION": "read-write",
        "LOG_LEVEL": "info"
      }
    },

    "openapi": {
      "type": "local",
      "command": ["uvx", "awslabs.openapi-mcp-server@latest"],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "API_NAME": "vehicle-rental-api",
        "API_BASE_URL": "http://localhost:3000/api",
        "API_SPEC_PATH": "/home/ahdevworker03/Abdallah Hassoun/Software Engineering/4- Projects/3- client/markab/lib/api-spec/openapi.yaml",
        "LOG_LEVEL": "ERROR",
        "ENABLE_OPERATION_PROMPTS": "true",
        "ALLOW_INSECURE_HTTP": "true",
        "ALLOW_PRIVATE_NETWORKS": "true"
      }
    },

    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },

    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "enabled": true
    },

    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CLOUDFLARE_API_TOKEN}"
      }
    },

    "postgresql": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:5432/vehicle_rental"
      ],
      "enabled": true
    },

    "docker": {
      "type": "local",
      "command": ["npx", "-y", "@alisaitteke/docker-mcp"],
      "enabled": true
    },

    "contabo": {
      "type": "local",
      "command": ["npx", "-y", "@kieksme/contabo-mcp"],
      "enabled": true,
      "environment": {
        "CONTABO_CLIENT_ID": "{env:CONTABO_CLIENT_ID}",
        "CONTABO_CLIENT_SECRET": "{env:CONTABO_CLIENT_SECRET}",
        "CONTABO_API_USER": "{env:CONTABO_API_USER}",
        "CONTABO_API_PASSWORD": "{env:CONTABO_API_PASSWORD}"
      }
    },

    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false
    }
  }
}
