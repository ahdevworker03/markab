generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?

  users      User[]
  customers  Customer[]
  vehicles   Vehicle[]
  rentals    Rental[]
  contracts  Contract[]
  documents  Document[]
  photos     Photo[]

  @@index([deleted_at])
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  OUT_OF_SERVICE
  ARCHIVED
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum DocumentCategory {
  REGISTRATION
  INSURANCE
  OTHER
}

enum RentalStatus {
  RESERVED
  ACTIVE
  RETURNED
  CANCELLED
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique
  password_hash   String
  role            Role           @default(OWNER)
  organization_id String         @db.Uuid
  organization    Organization   @relation(fields: [organization_id], references: [id])
  refresh_tokens  RefreshToken[]
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  deleted_at      DateTime?

  @@index([organization_id])
  @@index([deleted_at])
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model Customer {
  id                  String    @id @default(uuid()) @db.Uuid
  organization_id     String    @db.Uuid
  organization        Organization @relation(fields: [organization_id], references: [id])
  first_name          String
  last_name           String
  phone               String
  address             String
  national_id         String
  license_number      String
  license_expiry_date DateTime
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  @@unique([organization_id, national_id])
  @@unique([organization_id, license_number])
  @@index([organization_id])
  @@index([deleted_at])
  @@index([first_name])
  @@index([last_name])
  @@index([phone])
  @@index([national_id])
  @@index([license_number])

  rentals   Rental[]
  documents Document[]
}

model Vehicle {
  id               String         @id @default(uuid()) @db.Uuid
  organization_id  String         @db.Uuid
  organization     Organization   @relation(fields: [organization_id], references: [id])
  make             String
  model            String
  plate_number     String
  year             Int
  color            String
  vin              String?
  engine_number    String?
  transmission     Transmission
  fuel_type        FuelType
  seats            Int
  current_mileage  Int            @default(0)
  status           VehicleStatus  @default(AVAILABLE)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  deleted_at       DateTime?

  documents Document[]
  photos    Photo[]
  rentals   Rental[]

  @@unique([organization_id, plate_number])
  @@index([organization_id])
  @@index([deleted_at])
  @@index([status])
  @@index([make])
  @@index([model])
  @@index([plate_number])
}

model Document {
  id                String           @id @default(uuid()) @db.Uuid
  organization_id   String           @db.Uuid
  organization      Organization     @relation(fields: [organization_id], references: [id])
  vehicle_id        String?          @db.Uuid
  vehicle           Vehicle?         @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  customer_id       String?          @db.Uuid
  customer          Customer?        @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  category          DocumentCategory @default(OTHER)
  original_filename String
  mime_type         String
  file_size         Int
  storage_key       String           @unique
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  deleted_at        DateTime?

  @@index([organization_id])
  @@index([vehicle_id])
  @@index([customer_id])
  @@index([category])
  @@index([deleted_at])
}

model Photo {
  id                String   @id @default(uuid()) @db.Uuid
  organization_id   String   @db.Uuid
  organization      Organization @relation(fields: [organization_id], references: [id])
  vehicle_id        String   @db.Uuid
  vehicle           Vehicle  @relation(fields: [vehicle_id], references: [id])
  sort_order        Int      @default(0)
  caption           String?
  original_filename String
  mime_type         String
  file_size         Int
  storage_key       String   @unique
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  deleted_at        DateTime?

  @@index([organization_id])
  @@index([vehicle_id])
  @@index([vehicle_id, sort_order])
  @@index([deleted_at])
}

model Rental {
  id                   String        @id @default(uuid()) @db.Uuid
  organization_id      String        @db.Uuid
  organization         Organization  @relation(fields: [organization_id], references: [id])
  customer_id          String        @db.Uuid
  customer             Customer      @relation(fields: [customer_id], references: [id])
  vehicle_id           String        @db.Uuid
  vehicle              Vehicle       @relation(fields: [vehicle_id], references: [id])
  pickup_date          DateTime
  expected_return_date DateTime
  actual_pickup_date   DateTime?
  actual_return_date   DateTime?
  status               RentalStatus  @default(RESERVED)
  daily_rate           Decimal       @db.Decimal(10, 2)
  total_amount         Decimal       @db.Decimal(10, 2)
  deposit_amount       Decimal       @db.Decimal(10, 2)
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  deleted_at           DateTime?

  contract  Contract?

  @@index([organization_id])
  @@index([customer_id])
  @@index([vehicle_id])
  @@index([status])
  @@index([pickup_date])
  @@index([expected_return_date])
  @@index([vehicle_id, pickup_date, expected_return_date])
  @@index([deleted_at])
}

model Contract {
  id                   String        @id @default(uuid()) @db.Uuid
  organization_id      String        @db.Uuid
  organization         Organization  @relation(fields: [organization_id], references: [id])
  rental_id            String        @db.Uuid
  rental               Rental        @relation(fields: [rental_id], references: [id])
  pickup_date          DateTime
  expected_return_date DateTime
  daily_rate           Decimal       @db.Decimal(10, 2)
  total_amount         Decimal       @db.Decimal(10, 2)
  deposit_amount       Decimal       @db.Decimal(10, 2)
  customer_first_name  String
  customer_last_name   String
  customer_national_id String
  vehicle_make         String
  vehicle_model        String
  vehicle_plate_number String
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt
  deleted_at           DateTime?

  @@unique([rental_id])
  @@index([organization_id])
  @@index([rental_id])
  @@index([deleted_at])
}
