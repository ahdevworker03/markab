# Copy this file outside Git, for example to /opt/markab/staging/.env, and chmod 600 it.
POSTGRES_USER=<staging-db-user>
POSTGRES_PASSWORD=<staging-db-password>
POSTGRES_DB=<staging-db-name>
DATABASE_URL=postgresql://<staging-db-user>:<staging-db-password>@db:5432/<staging-db-name>?schema=public
JWT_SECRET=<random-staging-jwt-secret>
REFRESH_TOKEN_SECRET=<random-staging-refresh-secret>
CORS_ORIGINS=https://staging.markab-lb.com
LOG_LEVEL=info
RELEASE_ID=<immutable-staging-git-commit-sha>
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<private-staging-r2-bucket>
BACKUP_R2_BUCKET=<private-staging-backup-r2-bucket>
BACKUP_R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=<staging-backup-r2-access-key-id>
BACKUP_R2_SECRET_ACCESS_KEY=<staging-backup-r2-secret-access-key>
RESEND_API_KEY=<resend-api-key>
RESEND_FROM=Markab <security@staging.markab-lb.com>
PASSWORD_RESET_FRONTEND_ORIGIN=https://staging.markab-lb.com
PASSWORD_RESET_FRONTEND_PATH=/password-reset

# Run after db is healthy and before starting/restarting api:
# docker compose --env-file /opt/markab/staging/.env -f apps/api/docker-compose.staging.yml run --rm --no-deps migrate deploy
# docker compose --env-file /opt/markab/staging/.env -f apps/api/docker-compose.staging.yml run --rm --no-deps migrate status
# docker compose --env-file /opt/markab/staging/.env -f apps/api/docker-compose.staging.yml --profile backup run --rm --no-deps backup
