# Copy this file outside Git, for example to /opt/markab/staging/.env, and chmod 600 it.
STAGING_API_HOST=staging.example.com
POSTGRES_USER=<staging-db-user>
POSTGRES_PASSWORD=<staging-db-password>
POSTGRES_DB=<staging-db-name>
DATABASE_URL=postgresql://<staging-db-user>:<staging-db-password>@db:5432/<staging-db-name>?schema=public
JWT_SECRET=<random-staging-jwt-secret>
REFRESH_TOKEN_SECRET=<random-staging-refresh-secret>
CORS_ORIGINS=https://staging.example.com
LOG_LEVEL=info

# Run after db is healthy and before starting/restarting api:
# docker build --target builder -f apps/api/Dockerfile -t vehicle-rental-api:migrate .
# docker run --rm --network vehicle-rental-staging_default --env-file /opt/markab/staging/.env vehicle-rental-api:migrate pnpm --filter @workspace/db exec prisma migrate deploy
