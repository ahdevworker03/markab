PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,https://x1gtk7w1-5173.uks1.devtunnels.ms
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_rental?schema=public
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=change-me-to-another-random-string-at-least-32-chars
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Required in production. Development may omit all four values to retain local no-delivery behavior.
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM=Markab <security@example.com>
PASSWORD_RESET_FRONTEND_ORIGIN=https://app.example.com
PASSWORD_RESET_FRONTEND_PATH=/password-reset

# Required in production. Set real values only in the deployment secret store.
R2_ACCOUNT_ID=replace_with_r2_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET=replace_with_private_r2_bucket

# Local-only Step 64A benchmark: set these in the shell, not in this development .env.
# NODE_ENV=benchmark
# DATABASE_URL=postgresql://<local-user>:<local-password>@127.0.0.1:5432/markab_benchmark?schema=public
# BENCHMARK_DATABASE_URL=<same exact local DATABASE_URL>
# BENCHMARK_PASSWORD=<local-only-benchmark-password>
# BENCHMARK_PROFILE=full-pilot  # or target-1000; default is full-pilot
# JWT_SECRET=<local-only-secret-at-least-32-characters>
# REFRESH_TOKEN_SECRET=<local-only-secret-at-least-32-characters>
# STORAGE_PROVIDER=local
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=<local Chromium executable if Playwright browser is unavailable>
