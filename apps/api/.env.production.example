# Copy this file outside Git, for example to /opt/markab/production/.env, and chmod 600 it.
# Do not run migrations, bootstrap accounts, or start this stack until the shared-VPS production preparation is approved.
API_IMAGE=<immutable-registry-image-digest>
RELEASE_ID=<immutable-git-commit-sha>
POSTGRES_USER=<production-db-user>
POSTGRES_PASSWORD=<production-db-password>
POSTGRES_DB=<production-db-name>
DATABASE_URL=postgresql://<production-db-user>:<production-db-password>@db:5432/<production-db-name>?schema=public
JWT_SECRET=<random-production-jwt-secret-at-least-32-characters>
REFRESH_TOKEN_SECRET=<random-production-refresh-secret-at-least-32-characters>
CORS_ORIGINS=https://markab-lb.com
LOG_LEVEL=info
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<production-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<production-r2-secret-access-key>
R2_BUCKET=markab-production-storage
BACKUP_R2_BUCKET=<private-production-backup-r2-bucket>
BACKUP_R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
BACKUP_R2_ACCESS_KEY_ID=<production-backup-r2-access-key-id>
BACKUP_R2_SECRET_ACCESS_KEY=<production-backup-r2-secret-access-key>
RESEND_API_KEY=<production-resend-api-key>
RESEND_FROM=<production-resend-sender>
PASSWORD_RESET_FRONTEND_ORIGIN=https://markab-lb.com
PASSWORD_RESET_FRONTEND_PATH=/password-reset
